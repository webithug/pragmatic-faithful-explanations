# Copy to .env (the code refuses to start without it).
# Paths are only used by the raw-data preprocessing scripts; everything else
# lives under the repository root (data/, checkpoints/, outputs/, logs/).
DATA_DIR=data
CHECKPOINT_DIR=checkpoints
# Raw PadChest images / PadChest-GR reports (only for Tier 3 preprocessing).
PADCHEST_ARCHIVE_DIR=/path/to/padchest/archive
# Only for the two LLM preprocessing scripts (Tier 3).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
